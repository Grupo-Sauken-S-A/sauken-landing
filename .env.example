# SMTP (Postfix de server). Con la app en el mismo equipo se puede usar 127.0.0.1;
# el certificado TLS se verifica contra SMTP_TLS_SERVERNAME.
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_TLS_SERVERNAME=sauken.com.ar
# Cuenta SMTP dedicada del portal (la crea y entrega jrios)
SMTP_USER=
SMTP_PASS=
# Remitente: debe existir y estar autorizado para SMTP_USER en sender_login de Postfix
MAIL_FROM=
# El destino es siempre info@sauken.com.ar y el asunto sale como "[Portal] <asunto>"
